# Server (port 5001 avoids the macOS service using port 5000)
PORT=5001
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Local MongoDB. For Atlas, replace this with your connection string.
MONGODB_URI=mongodb://127.0.0.1:27017/queueless

# Generate with: openssl rand -hex 32
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Used only by the one-time admin seed command. Change this password.
ADMIN_NAME=QueueLess Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThis-Admin-123!

# Groq Cloud is the primary provider; Google Gemini is the fallback.
# Create keys at https://console.groq.com/keys and https://aistudio.google.com/app/api-keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
# Verify the model ID available to your Google AI Studio account before demo day.
GEMINI_MODEL=gemini-2.5-flash
AI_TIMEOUT_MS=18000
